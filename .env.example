# =============================================================================
# Root Project Environment Configuration — ATS Score Checker
# Copy this file to .env and adjust variables as needed
# =============================================================================

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ats_checker_db

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
LLM_PROVIDER=gemini          # options: claude | gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# File Upload Limits
MAX_RESUMES_PER_JOB=20
MAX_FILE_SIZE_MB=5

# API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
