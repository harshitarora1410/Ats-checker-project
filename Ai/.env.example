# Optional local settings. Copy to .env only if you want to change a default.
# Never commit .env.
#
# THE API KEY IS NOT SET HERE. ANTHROPIC_API_KEY lives in GitHub secrets:
#   GitHub Settings > Codespaces > Secrets (and repo Actions secrets for CI)
# GitHub injects it as an environment variable when the Codespace starts.

# Claude
CLAUDE_MODEL=claude-haiku-5-5

# Generation
# 0 = most consistent scores across repeated runs
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# Batch
MAX_RESUMES_PER_BATCH=20
# How many resumes are sent to Claude at the same time
MAX_PARALLEL_RESUMES=5

LOG_LEVEL=INFO