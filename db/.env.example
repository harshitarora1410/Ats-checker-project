# =============================================================================
# Database Configuration for Algoworks ATS Checker
# =============================================================================

# PostgreSQL Connection String:
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ats_checker_db

# PostgreSQL Superuser (used by local setup scripts)
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=ats_checker_db
