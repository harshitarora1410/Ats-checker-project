# Copy to .env and adjust. Restart `npm run dev` after changing it.

# Backend origin, without /api.
# Deployed backend (default):
VITE_API_URL=https://ats-backend-algoworks.onrender.com
# Local backend instead:
# VITE_API_URL=http://localhost:8000

# true  = in-browser mock service, no backend needed
#         (login: vaibhav.shukla@algoworks.com / Algoworks@123)
# false = real backend at VITE_API_URL (default)
VITE_USE_MOCK=false
